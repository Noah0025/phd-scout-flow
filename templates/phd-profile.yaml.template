# phd-scout-flow profile
# Generated by /phd-scout-init. Edit manually if your preferences change.

version: "1.0"
updated_at: "YYYY-MM-DD"

notion:
  inbox_database_id: "[notion_database_id]"

input_sources:
  capability_vault: "[/absolute/path/to/vault or empty]"
  fallback_paths:
    - "[/absolute/path/to/cv_or_transcript]"

# 用户偏好
regions: ["open"]            # ["Europe", "Oceania", ...] 或 ["open"]
start_window: "open"         # "2026 Fall" / "open"
opportunity_types:
  enabled:
    - project_position
    - pi_open_call
    # 可加：pi_cold_email / cdt_dtp / msca_dn / outbound_scholarship / industrial_phd
funding: "funded_only"       # funded_only | accept_self_funded | already_funded
language: ["English"]        # 可多选：English / German / French / ...

preferred_sources:
  institutions: []           # 例: ["Example University", "Example Research Institute"]
  sites: []                  # 例: ["example.edu", "research.example.org"] 用于 site: 操作符

# 搜索预算（精简到 3 项；其余 SKILL 内置默认）
search:
  queries_per_type: 3        # 每形态主搜轮数
  results_per_query: 20      # 每查询取前 N 条结果
  max_written_per_scout: 1   # 一次 scout 最多写入 Notion 几条（推荐 1，反馈精准）
